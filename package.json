{
  "name": "@bioflow/cli",
  "version": "0.0.1",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "bioflow": "dist/cli/main.js",
    "bioflow-mcp": "dist/mcp/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-build-assets.mjs",
    "check": "npm run typecheck && npm run test:serial && npm run verify:golden",
    "check:ci": "tsx scripts/check-ci.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:serial": "vitest run --pool=threads --poolOptions.threads.singleThread=true",
    "test:service:integration": "BIOFLOW_RUN_SERVICE_INTEGRATION=1 vitest run test/service-metrics.test.ts test/service-hosted-beta-ready.test.ts --pool=threads --poolOptions.threads.singleThread=true --testTimeout=20000",
    "test:packaged-cli": "BIOFLOW_RUN_PACKAGED_CLI_TEST=1 vitest run test/packaged-cli.test.ts",
    "test:rls": "vitest run test/rls.integration.test.ts",
    "test:watch": "vitest",
    "fixture:golden:generate": "tsx scripts/generate-golden-fixture.ts",
    "verify:golden": "tsx scripts/verify-golden.ts",
    "demo:killer": "tsx scripts/demo-killer.ts",
    "demo:killer:ci": "tsx scripts/demo-killer-ci.ts",
    "demo:sample-sheet:local": "tsx scripts/demo-sample-sheet-beta.ts --mode local",
    "demo:sample-sheet:service": "tsx scripts/demo-sample-sheet-beta.ts --mode service",
    "demo:self-serve:smoke": "tsx scripts/self-serve-smoke.ts",
    "demo:self-serve:autopilot": "npm run -s bioflow -- autopilot:run --enforce-policy --out ./.bioflow/self-serve-autopilot.json && npm run -s bioflow -- autopilot:gate ./.bioflow/self-serve-autopilot.json --json",
    "demo:verify": "tsx scripts/demo-verify.ts",
    "demo:tidy": "tsx scripts/demo-tidy.ts",
    "admin:create-org-key": "tsx scripts/admin-create-org-key.ts",
    "admin:provision:prod": "node dist/service/admin/provision-main.js",
    "admin:signup-attempts:prod": "node dist/service/admin/signup-attempts-main.js",
    "admin:gc:prod": "node dist/service/admin/gc-main.js",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:migrate:prod": "node dist/service/db/migrate-main.js",
    "service:api": "tsx src/service/api/main.ts",
    "service:worker": "tsx src/temporal/worker/main.ts",
    "start": "node dist/service/api/server.js",
    "start:worker": "node dist/temporal/worker/main.js",
    "bioflow": "tsx src/cli/main.ts",
    "mcp": "tsx src/mcp/main.ts",
    "pack:cli": "npm pack --json"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^9.0.1",
    "@fastify/sensible": "^6.0.3",
    "@temporalio/client": "^1.13.1",
    "@temporalio/worker": "^1.13.1",
    "@temporalio/workflow": "^1.13.1",
    "fastify": "^5.2.1",
    "ioredis": "^5.9.2",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^9.1.0",
    "stripe": "^18.5.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
