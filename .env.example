# Service mode (API + worker)
BIOFLOW_PORT=8080
BIOFLOW_DATABASE_URL=postgres://bioflow:bioflow@localhost:5432/bioflow

# Auth (dev): accept `x-org-id` header when JWT is not configured
# SECURITY: keep this false in production. If enabled, the API accepts `x-org-id` without JWT/API key.
BIOFLOW_DEV_ALLOW_ORG_HEADER=false
# BIOFLOW_JWT_SECRET=replace-with-32+chars
# API key auth (recommended for production)
# BIOFLOW_API_KEY_PEPPER=replace-with-32+chars

# HTTP hardening (browser-facing)
# Comma-separated allowlist for CORS origins. Requests without an Origin header (typical CLI) are unaffected.
BIOFLOW_ALLOWED_ORIGINS=https://bioflow.io
# Trust proxy headers (set true behind a reverse proxy / load balancer)
BIOFLOW_TRUST_PROXY=false

# Redis (optional; enables multi-replica rate limiting)
# BIOFLOW_REDIS_URL=redis://localhost:6379

# CAS quotas / disk safety (bytes; set to 0 to disable a limit)
# Default max object = 1GiB
BIOFLOW_CAS_MAX_OBJECT_BYTES=1073741824
# Default tenant CAS quota = 10GiB
BIOFLOW_TENANT_CAS_MAX_BYTES=10737418240
# Keep at least 2GiB free on the volume that holds BIOFLOW_SERVICE_DATA_DIR
BIOFLOW_CAS_MIN_FREE_BYTES=2147483648

# Per-org HTTP rate limiting (set POINTS=0 to disable)
BIOFLOW_HTTP_RATE_LIMIT_POINTS=100
BIOFLOW_HTTP_RATE_LIMIT_DURATION_SECONDS=60
BIOFLOW_HTTP_RATE_LIMIT_BLOCK_SECONDS=900
# Optional: override public self-serve signup rate limits (falls back to BIOFLOW_HTTP_RATE_LIMIT_* when unset)
# BIOFLOW_SIGNUP_RATE_LIMIT_POINTS=20
# BIOFLOW_SIGNUP_RATE_LIMIT_DURATION_SECONDS=60
# BIOFLOW_SIGNUP_RATE_LIMIT_BLOCK_SECONDS=900

# Expensive operation caps (per process)
BIOFLOW_DEEP_VERIFY_MAX_CONCURRENCY=3
BIOFLOW_DEEP_VERIFY_MAX_QUEUE=100

# Metrics (Prometheus format)
BIOFLOW_METRICS_ENABLED=false
# If set, `/metrics` requires `Authorization: Bearer <token>`. If unset, only loopback can access.
# BIOFLOW_METRICS_BEARER_TOKEN=replace-with-32+chars

# Runner mode: `temporal` (default) or `inline`
BIOFLOW_RUNNER_MODE=temporal
BIOFLOW_TEMPORAL_ADDRESS=localhost:7233
BIOFLOW_TEMPORAL_NAMESPACE=default
BIOFLOW_TEMPORAL_TASK_QUEUE=bioflow

# Shared content-addressed store for the service layer
BIOFLOW_SERVICE_DATA_DIR=.bioflow_service

# Billing (Stripe)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_TEAM=price_...
# STRIPE_PRICE_ENTERPRISE=price_...
# BIOFLOW_BILLING_SUCCESS_URL=https://example.invalid/success
# BIOFLOW_BILLING_CANCEL_URL=https://example.invalid/cancel
